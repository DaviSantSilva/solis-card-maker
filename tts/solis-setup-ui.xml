<!--
  Solis — UI do painel de setup

  Como instalar:
  No editor de Global do TTS existem DUAS abas: "Script" e "UI".
  Cole solis-global.lua na aba SCRIPT.
  Cole ESTE arquivo inteiro na aba UI.

  Não precisa (e não deve) ter Global.UI.setXml() no script Lua —
  o TTS carrega o conteúdo desta aba automaticamente.
-->

<Defaults>
  <Panel class="section" color="#1a1d22" outline="#252930" outlineSize="1 1"/>
  <Text class="heading" color="#eceef3" fontSize="17" fontStyle="bold" alignment="MiddleLeft"/>
  <Text class="label" color="#8892a4" fontSize="13" alignment="MiddleLeft"/>
  <Toggle textColor="#eceef3" fontSize="16"/>
</Defaults>

<Panel id="solisSetupPanel" rectAlignment="MiddleCenter" offsetXY="0 0" width="620" height="740"
       color="#0c0d0fee" outline="#252930" outlineSize="2 2"
       allowDragging="true" returnToOriginalPositionWhenReleased="false">

  <VerticalLayout padding="0 0 0 0" spacing="0">

    <!-- cabeçalho -->
    <Panel color="#131518" height="86" outline="#252930" outlineSize="0 1">
      <VerticalLayout padding="24 24 14 14" spacing="2">
        <Text text="SOLIS" fontSize="30" fontStyle="bold" color="#eceef3" alignment="MiddleLeft" height="36"/>
        <Text text="Configuração de mesa" fontSize="14" color="#4a5168" alignment="MiddleLeft" height="20"/>
      </VerticalLayout>
      <Button id="closePanelButton" text="✕" onClick="onCloseClick"
              position="280 0 0" width="40" height="40"
              color="#00000000" textColor="#4a5168" fontSize="20"/>
    </Panel>

    <VerticalLayout padding="28 28 20 20" spacing="22">

      <!-- jogadores -->
      <VerticalLayout spacing="10">
        <Text class="heading" text="Jogadores" height="22"/>
        <HorizontalLayout spacing="20" height="34">
            <Toggle id="players_1" text="1" onValueChanged="onPlayersToggle"/>
            <Toggle id="players_2" text="2" onValueChanged="onPlayersToggle"/>
            <Toggle id="players_3" text="3" onValueChanged="onPlayersToggle"/>
            <Toggle id="players_4" text="4" onValueChanged="onPlayersToggle"/>
            <Toggle id="players_5" text="5" onValueChanged="onPlayersToggle" isOn="true"/>
        </HorizontalLayout>
      </VerticalLayout>

      <!-- separador -->
      <Panel color="#1c1f26" height="1"/>

      <!-- idioma -->
      <VerticalLayout spacing="10">
        <Text class="heading" text="Idioma" height="22"/>
        <GridLayout cellSize="90 34" spacing="12 10" constraintCount="3" height="80">
            <Toggle id="locale_pt" text="PT" onValueChanged="onLocaleToggle" isOn="true"/>
            <Toggle id="locale_en" text="EN" onValueChanged="onLocaleToggle"/>
            <Toggle id="locale_es" text="ES" onValueChanged="onLocaleToggle"/>
            <Toggle id="locale_fr" text="FR" onValueChanged="onLocaleToggle"/>
            <Toggle id="locale_de" text="DE" onValueChanged="onLocaleToggle"/>
            <Toggle id="locale_zh" text="ZH" onValueChanged="onLocaleToggle"/>
        </GridLayout>
      </VerticalLayout>

      <Panel color="#1c1f26" height="1"/>

      <!-- modo -->
      <VerticalLayout spacing="10">
        <Text class="heading" text="Modo de setup" height="22"/>
        <HorizontalLayout spacing="24" height="34">
            <Toggle id="mode_auto"   text="Automático" onValueChanged="onModeToggle" isOn="true"/>
            <Toggle id="mode_manual" text="Manual"     onValueChanged="onModeToggle"/>
        </HorizontalLayout>
        <Text class="label" text="Automático: entrega os decks direto aos jogadores sentados nas cores das corporações." height="34"/>
        <Text class="label" text="Manual: gera todos os decks empilhados fora da mesa, para você distribuir." height="34"/>
      </VerticalLayout>

      <!-- status -->
      <Text id="setupStatusText" text="" fontSize="14" color="#f59e0b" height="24" alignment="MiddleCenter"/>

      <!-- ação -->
      <Button id="startSetupButton" text="COMEÇAR" onClick="onStartSetupClick"
              height="58" fontSize="22" fontStyle="bold"
              colors="#3b82f6|#2563eb|#1d4ed8|#1a1d22" textColor="#ffffff"/>

    </VerticalLayout>
  </VerticalLayout>
</Panel>

<!-- botão discreto para reabrir o painel depois de fechado -->
<Button id="reopenPanelButton" text="⚙" onClick="onReopenClick"
        rectAlignment="LowerRight" offsetXY="-30 90" width="44" height="44"
        color="#131518cc" textColor="#8892a4" fontSize="20" active="false"/>
